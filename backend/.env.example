# Base de Datos (SQLite por defecto en desarrollo local, PostgreSQL en producción)
DATABASE_URL=sqlite:///./gestor_proyectos.db

# Seguridad JWT (HS256)
JWT_SECRET_KEY=dev-secret-key-change-in-production-gestor-proyectos-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Modo de Desarrollo OAuth2 / OIDC (true habilita el simulador determinístico de Google y Microsoft)
AUTH_DEV_MODE=true
FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# Credenciales OAuth2 Google (Opcionales cuando AUTH_DEV_MODE=true)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credenciales OAuth2 Microsoft / Entra ID (Opcionales cuando AUTH_DEV_MODE=true)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

